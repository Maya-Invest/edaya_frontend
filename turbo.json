{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".generated/client.json"
  ],
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false
    },
    "build": {
      "outputs": [
        "dist/**",
        "build/**",
        ".svelte-kit/**"
      ]
    },
    "check": {
      "dependsOn": [
        "^check"
      ]
    },
    "quality": {
      "dependsOn": [
        "^check"
      ]
    },
    "test": {
      "dependsOn": [
        "^check"
      ]
    },
    "lint": {},
    "lint:fix": {}
  },
  "globalEnv": [
    "PUBLIC_TEST_OTP_ACCESS"
  ]
}
