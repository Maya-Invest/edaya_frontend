{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false
    },
    "build": {
      "outputs": ["dist/**", "build/**", ".svelte-kit/**"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "quality": {
      "dependsOn": ["^check"]
    },
    "test": {
      "dependsOn": ["^check"]
    },
    "lint": {},
    "lint:fix": {}
  }
}
