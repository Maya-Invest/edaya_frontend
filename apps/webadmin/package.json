{
	"name": "@edaya/webadmin",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "bun x --bun vite dev --port 5174",
		"build": "bun x --bun vite build",
		"preview": "bun x --bun vite preview",
		"preview:production": "bun x wrangler dev --env prod",
		"prepare": "bun x --bun svelte-kit sync",
		"check": "bun x --bun svelte-check --tsconfig ./tsconfig.json && bun x --bun tsc --project tsconfig.test.json --noEmit",
		"check:watch": "bun x --bun svelte-check --tsconfig ./tsconfig.json --watch",
		"quality": "bun run lint && bun run check",
		"test": "bun test src",
		"lint": "bun x --bun eslint src",
		"lint:fix": "bun x --bun eslint src --fix"
	},
	"dependencies": {
		"@maya-invest/edaya-api-client": "file:../../.generated/api-client",
		"clsx": "^2.1.1",
		"lucide-svelte": "^1.0.1",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250617.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/typography": "^0.5.19",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.2",
		"autoprefixer": "^10.5.0",
		"postcss": "^8.5.15",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^3.4.19",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"wrangler": "^4.153.0"
	}
}
