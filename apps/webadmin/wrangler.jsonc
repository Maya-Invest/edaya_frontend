{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Static SPA from `vite build` (adapter-static). SvelteKit bakes `$env/static/public`
	// at build time — set the same PUBLIC_* values when running `bun run build` before deploy
	// (see package.json deploy:* scripts). Vars below mirror those builds for wrangler dev / docs.
	// Top-level name is not a deploy target. Always use `--env staging` or `--env prod`
	// so this cannot overwrite the production Worker (`edaya-webadmin`).
	"name": "edaya-webadmin-local",
	"compatibility_date": "2024-09-23",
	"workers_dev": false,
	"assets": {
		"directory": "./build",
		"not_found_handling": "single-page-application"
	},
	"env": {
		"prod": {
			"name": "edaya-webadmin",
			"vars": {
				"PUBLIC_AUTH_URL": "https://identity.api.edayaplus.com",
				"PUBLIC_API_URL": "https://school.api.edayaplus.com",
				"PUBLIC_APP_ENV": "production"
			},
			"routes": [
				{
					"pattern": "admin.edayaplus.com",
					"custom_domain": true
				}
			]
		},
		"staging": {
			"name": "edaya-webadmin-staging",
			"vars": {
				"PUBLIC_AUTH_URL": "https://staging.identity.api.edayaplus.com",
				"PUBLIC_API_URL": "https://staging.school.api.edayaplus.com",
				"PUBLIC_APP_ENV": "staging"
			},
			"routes": [
				{
					"pattern": "staging.admin.edayaplus.com",
					"custom_domain": true
				}
			]
		}
	}
}
