# Vite dev proxy targets (bun dev).
API_URL=http://localhost:9999

# Client-side unified API origin.
# Staging: https://staging.api.edayaplus.com
# Production: https://api.edayaplus.com
PUBLIC_API_URL=http://localhost:9999
PUBLIC_APP_ENV=
# PUBLIC_PROFILE_PHOTO_MAX_BYTES=1048576
# PUBLIC_APP_ENV=staging

# Show signup panel on /login (default: true in dev/staging, false in production builds)
# PUBLIC_ALLOW_SCHOOL_REGISTRATION=true

# bun repo dev enables this by default. Other entry points require an explicit opt-in.
# Set PUBLIC_TEST_OTP_ACCESS=false in the shell to opt out of bun repo dev.
PUBLIC_TEST_OTP_ACCESS=false
