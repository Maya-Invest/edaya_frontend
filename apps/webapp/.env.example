# Vite dev proxy targets (bun dev).
AUTH_URL=http://localhost:9900
API_URL=http://localhost:9999

# Client-side Identity and School API origins.
# PUBLIC_AUTH_URL is required and must not be empty.
# Staging: https://staging.identity.api.edayaplus.com / https://staging.school.api.edayaplus.com
# Production: https://identity.api.edayaplus.com / https://school.api.edayaplus.com
PUBLIC_AUTH_URL=http://localhost:9900
PUBLIC_API_URL=http://localhost:9999
PUBLIC_APP_ENV=
# PUBLIC_PROFILE_PHOTO_MAX_BYTES=1048576
# PUBLIC_APP_ENV=staging

# Show signup panel on /login (default: true in dev/staging, false in production builds)
# PUBLIC_ALLOW_SCHOOL_REGISTRATION=true
