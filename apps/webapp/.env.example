# Vite dev proxy target (bun dev). Leave PUBLIC_API_URL empty to use same-origin /core, /auth, and /public via proxy.
API_URL=http://localhost:9999

# Client-side API + Better Auth base URL. Empty in local dev → Vite proxy.
# Staging build: PUBLIC_API_URL=https://staging.api.edayaplus.com PUBLIC_APP_ENV=staging
# Production build: PUBLIC_API_URL=https://api.edayaplus.com
PUBLIC_API_URL=
PUBLIC_APP_ENV=
# PUBLIC_APP_ENV=staging

# Show signup panel on /login (default: true in dev/staging, false in production builds)
# PUBLIC_ALLOW_SCHOOL_REGISTRATION=true
