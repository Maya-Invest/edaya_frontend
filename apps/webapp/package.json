{
  "name": "@edaya/webapp",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun x --bun vite dev",
    "build": "bun x --bun vite build",
    "preview": "bun x --bun vite preview",
    "preview:integration": "bun x wrangler dev --local --port 4173 --ip 127.0.0.1",
    "preview:production": "bun x wrangler dev --env prod",
    "prepare": "bun x --bun svelte-kit sync",
    "check": "bun x --bun svelte-check --tsconfig ./tsconfig.json && bun x --bun tsc --project tsconfig.test.json --noEmit",
    "check:watch": "bun x --bun svelte-check --tsconfig ./tsconfig.json --watch",
    "quality": "bun run lint && bun run check",
    "test": "bun test tests/lib tests/integration/setup/journey-ledger.test.ts && bun test tests/integration/messaging.test.ts && bun test tests/integration/family-feedback-mutations.test.ts && bun test tests/integration/account-linking.test.ts && bun test tests/integration/timetable-state.test.ts && bun test tests/integration/passwordless-state.test.ts && bun test tests/integration/permission-form-state.test.ts",
    "demo:e2e": "bun scripts/demo-dry-run.ts",
    "qa:checklist": "bun scripts/qa-checklist-run.ts",
    "qa:template": "bun scripts/generate-qa-template.ts",
    "qa:report:detailed": "bun scripts/generate-qa-detailed-report.ts",
    "qa:matrix:sync": "bun scripts/sync-qa-matrix.ts",
    "qa:matrix": "bun scripts/qa-matrix-run.ts",
    "test:integration:provisioned": "bun scripts/integration-run.ts",
    "test:integration:onboarding": "bun scripts/onboarding-run.ts",
    "qa:compile": "bun scripts/compile-qa-results.ts",
    "lint": "bun x --bun eslint src",
    "lint:fix": "bun x --bun eslint src --fix",
    "test:integration:coverage": "bun test tests/lib/catalog-drift.test.ts && bun scripts/integration-coverage.ts",
    "test:integration:webadmin": "bun scripts/webadmin-integration.ts",
    "test:integration:availability": "bun scripts/phone-availability-browser.ts",
    "test:integration:messaging-ui": "bun tests/integration/messaging-browser.ts",
    "test:integration:family-feedback-ui": "bun tests/integration/family-feedback-browser.ts",
    "test:integration:permission-profiles": "bun tests/integration/permission-profiles-browser.ts",
    "test:integration:timetable-selection": "bun tests/integration/timetable-selection-browser.ts",
    "screenshots": "bun scripts/screenshots.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "@maya-invest/edaya-api-client": "file:../../.generated/api-client",
    "@svar-ui/calendar-locales": "^2.6.0",
    "@svar-ui/core-locales": "^2.6.0",
    "@svar-ui/lib-dom": "^0.13.1",
    "@svar-ui/svelte-calendar": "^2.6.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-svelte": "^1.0.1",
    "papaparse": "^5.5.4",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250617.0",
    "@edaya/web-fixtures": "workspace:*",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.2",
    "@types/papaparse": "^5.5.2",
    "autoprefixer": "^10.5.0",
    "playwright": "1.52.0",
    "postcss": "^8.5.15",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "wrangler": "^4.99.0"
  }
}
