{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Static SPA from `vite build` (adapter-static). SvelteKit bakes `$env/static/public`
	// at build time — set the same PUBLIC_* values when running `bun run build` before deploy
	// (see package.json deploy:* scripts). Vars below mirror those builds for wrangler dev / docs.
	"name": "edaya-webapp",
	"compatibility_date": "2024-09-23",
	"assets": {
		"directory": "./build",
		"not_found_handling": "single-page-application"
	},
	"env": {
		"prod": {
			"name": "edaya-webapp",
			"vars": {
				"PUBLIC_API_URL": "https://api.edaya.softilab.dev",
				"PUBLIC_APP_ENV": "production"
			},
			"routes": [
				{
					"pattern": "app.edaya.softilab.dev",
					"custom_domain": true
				}
			]
		},
		"staging": {
			"name": "edaya-webapp-staging",
			"vars": {
				"PUBLIC_API_URL": "https://api-staging.edaya.softilab.dev",
				"PUBLIC_APP_ENV": "staging",
				"PUBLIC_ALLOW_SCHOOL_REGISTRATION": "true"
			},
			"routes": [
				{
					"pattern": "app-staging.edaya.softilab.dev",
					"custom_domain": true
				}
			]
		}
	}
}
