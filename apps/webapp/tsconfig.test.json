{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"types": ["@cloudflare/workers-types", "bun", "svelte"],
		"noEmit": true,
		"paths": {
			"$api-client": ["./src/generated/api-client"],
			"$api-client/*": ["./src/generated/api-client/*"],
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"$tests/*": ["./tests/*"]
		}
	},
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/non-ambient.d.ts",
		"tests/support/ambient.d.ts",
		"tests/**/*.test.ts",
		"tests/integration/**/*.ts",
		"src/generated/api-client/create-client.typecheck.ts"
	],
	"exclude": []
}
