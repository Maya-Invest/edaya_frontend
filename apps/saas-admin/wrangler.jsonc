{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Static SPA output from `vite build` (adapter-static).
	// Build with PUBLIC_API_URL=https://api.edayaplus.com before deploy.
	"name": "edaya-saas-admin",
	"compatibility_date": "2024-09-23",
	"assets": {
		"directory": "./build",
		"not_found_handling": "single-page-application"
	},
	"env": {
		"prod": {
			"name": "edaya-saas-admin",
			"routes": [
				{
					"pattern": "admin.edayaplus.com",
					"custom_domain": true
				}
			]
		},
		"staging": {
			"name": "edaya-saas-admin-staging",
			"routes": [
				{
					"pattern": "staging.admin.edayaplus.com",
					"custom_domain": true
				}
			]
		}
	}
}
