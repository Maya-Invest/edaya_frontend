{
	"name": "@edaya/saas-admin",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev --port 5174",
		"build": "vite build",
		"preview": "vite preview",
		"preview:production": "wrangler dev --env prod",
		"deploy:production": "bun run build && wrangler deploy --env prod",
		"deploy:production:dry-run": "bun run build && wrangler deploy --env prod --dry-run",
		"deploy:staging": "PUBLIC_API_URL=https://api-staging.edaya.softilab.dev PUBLIC_APP_ENV=staging bun run build && wrangler deploy --env staging",
		"deploy:staging:dry-run": "PUBLIC_API_URL=https://api-staging.edaya.softilab.dev PUBLIC_APP_ENV=staging bun run build && wrangler deploy --env staging --dry-run",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.test.json --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"quality": "bun run lint && bun run check",
		"test": "bun test src",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"lucide-svelte": "^1.0.1",
		"tailwind-merge": "^3.6.0",
		"@maya-invest/edaya-api-client": "file:../../edaya_backend/package/api-client"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250617.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/typography": "^0.5.19",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.2",
		"autoprefixer": "^10.5.0",
		"postcss": "^8.5.15",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^3.4.19",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"wrangler": "^4.99.0"
	}
}
