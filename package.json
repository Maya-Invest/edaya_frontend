{
  "name": "@edaya/web",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "repo": "bun tooling/repo/cli/main.ts",
    "build": "turbo run build",
    "check": "turbo run check",
    "quality": "turbo run quality",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "verify": "bun repo verify && turbo run quality && turbo run build && turbo run test -- --dots",
    "dev": "turbo run dev --filter=@edaya/webapp --filter=@edaya/saas-admin",
    "dev:webapp": "bun --filter @edaya/webapp dev",
    "dev:saas-admin": "bun --filter @edaya/saas-admin dev",
    "deploy:webapp:production": "bun --filter @edaya/webapp deploy:production",
    "deploy:webapp:staging": "bun --filter @edaya/webapp deploy:staging",
    "deploy:saas-admin:production": "bun --filter @edaya/saas-admin deploy:production",
    "deploy:saas-admin:staging": "bun --filter @edaya/saas-admin deploy:staging"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^25.9.2",
    "eslint": "^9.39.0",
    "eslint-plugin-format": "^0.1.2",
    "eslint-plugin-svelte": "^3.19.0",
    "svelte-eslint-parser": "^1.8.0",
    "turbo": "^2.9.17",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "@sveltejs/kit": "2.64.0",
    "svelte": "5.56.3",
    "vite": "8.0.16",
    "@maya-invest/edaya-api-client": "file:edaya-client-codegen/clients/school-api"
  }
}
