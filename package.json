{
  "name": "@edaya/web",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "tooling/*"
  ],
  "scripts": {
    "prepare": "bun --no-env-file tooling/repo/ops/hooks.ts",
    "repo": "bun --no-env-file tooling/repo/ops/main.ts",
    "build": "bun x --bun turbo run build",
    "check": "bun x --bun turbo run check",
    "quality": "bun x --bun turbo run quality",
    "lint": "bun x --bun turbo run lint",
    "lint:fix": "bun x --bun turbo run lint:fix",
    "test": "bun x --bun turbo run test --concurrency=1",
    "test:integration:onboarding": "bun --filter @edaya/webapp test:integration:onboarding",
    "test:integration:provisioned": "bun --filter @edaya/webapp test:integration:provisioned",
    "verify": "bun run repo ci verify",
    "dev": "bun x --bun turbo run dev --filter=@edaya/webapp --filter=@edaya/webadmin",
    "dev:webapp": "bun --filter @edaya/webapp dev",
    "dev:webadmin": "bun --filter @edaya/webadmin dev",
    "brand:generate": "bun run repo generate brand",
    "brand:check": "bun run repo check",
    "test:integration:coverage": "bun --filter @edaya/webapp test:integration:coverage",
    "test:integration:webadmin": "bun --filter @edaya/webapp test:integration:webadmin",
    "test:integration:availability": "bun --filter @edaya/webapp test:integration:availability",
    "screenshots": "bun --filter @edaya/webapp screenshots"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^25.9.2",
    "eslint": "^9.39.0",
    "eslint-plugin-format": "^0.1.2",
    "eslint-plugin-svelte": "^3.19.0",
    "svelte-eslint-parser": "^1.8.0",
    "turbo": "^2.9.17",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "@maya-invest/edaya-api-client": "file:./.generated/api-client",
    "@sveltejs/kit": "2.64.0",
    "svelte": "5.56.3",
    "vite": "8.0.16"
  }
}
