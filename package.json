{
  "name": "@edaya/web",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "prepare": "git rev-parse --git-dir &> /dev/null && git config core.hooksPath .githooks || true",
    "repo": "bun tooling/repo/cli/main.ts",
    "build": "turbo run build",
    "check": "turbo run check",
    "quality": "turbo run quality",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:integration:onboarding": "bun --filter @edaya/webapp test:integration:onboarding",
    "test:integration:provisioned": "bun --filter @edaya/webapp test:integration:provisioned",
    "verify": "bun test ./.github/scripts/*.test.mjs && python3 -m unittest discover -s .github/scripts -p 'test_*.py' && bun run contract:check && bun run brand:check && bun repo verify && turbo run quality && turbo run build && turbo run test -- --dots",
    "dev": "turbo run dev --filter=@edaya/webapp --filter=@edaya/webadmin",
    "dev:webapp": "bun --filter @edaya/webapp dev",
    "dev:webadmin": "bun --filter @edaya/webadmin dev",
    "deploy:webapp:production": "bun --filter @edaya/webapp deploy:production",
    "deploy:webapp:staging": "bun --filter @edaya/webapp deploy:staging",
    "deploy:webadmin:production": "bun --filter @edaya/webadmin deploy:production",
    "deploy:webadmin:staging": "bun --filter @edaya/webadmin deploy:staging",
    "deploy:website:production": "bun --filter @edaya/website deploy:production",
    "deploy:website:staging": "bun --filter @edaya/website deploy:staging",
    "cloudflare:prepare": "node scripts/cloudflare-build-prepare.mjs",
    "cloudflare:install": "bun run cloudflare:prepare && bun install",
    "cloudflare:build:webapp": "bun run cloudflare:install && bun --filter @edaya/webapp build",
    "cloudflare:build:webadmin": "bun run cloudflare:install && bun --filter @edaya/webadmin build",
    "cloudflare:build:website": "bun install && bun --filter @edaya/website build",
    "brand:generate": "python3 scripts/brand-tokens.py",
    "brand:check": "python3 scripts/brand-check.py",
    "contract:check": "python3 scripts/release-contract.py --role web",
    "test:integration:coverage": "bun --filter @edaya/webapp test:integration:coverage",
    "test:integration:webadmin": "bun --filter @edaya/webapp test:integration:webadmin",
    "test:integration:availability": "bun --filter @edaya/webapp test:integration:availability"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^25.9.2",
    "eslint": "^9.39.0",
    "eslint-plugin-format": "^0.1.2",
    "eslint-plugin-svelte": "^3.19.0",
    "svelte-eslint-parser": "^1.8.0",
    "turbo": "^2.9.17",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "@maya-invest/edaya-api-client": "file:./vendor/edaya-api-client",
    "@sveltejs/kit": "2.64.0",
    "svelte": "5.56.3",
    "vite": "8.0.16"
  }
}
