#!/usr/bin/env sh
set -eu

# Git hooks run with a minimal PATH; locate bun from common install locations.
export PATH="${BUN_INSTALL:+$BUN_INSTALL/bin:}$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

if command -v bun >/dev/null 2>&1; then
  BUN="$(command -v bun)"
else
  for candidate in \
    "${BUN_INSTALL:+$BUN_INSTALL/bin/bun}" \
    "$HOME/.bun/bin/bun" \
    /opt/homebrew/bin/bun \
    /usr/local/bin/bun
  do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      BUN="$candidate"
      break
    fi
  done
fi

if [ -z "${BUN:-}" ]; then
  echo "pre-commit: bun not found. Install bun or add it to PATH, then retry."
  exit 1
fi

root="$(git rev-parse --show-toplevel)"
cd "$root"

echo "→ Running bun repo verify..."
"$BUN" repo verify

echo "→ Running quality on changed packages (turbo --filter=...[HEAD])..."
"$BUN" x turbo run quality --filter=...[HEAD]
