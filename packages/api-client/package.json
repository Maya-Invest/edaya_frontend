{
  "name": "@edaya/api-client",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./openapi-bindings": {
      "types": "./src/openapi-bindings.ts",
      "import": "./src/openapi-bindings.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "test": "bun test src --dots",
    "lint": "eslint src --ignore-pattern src/generated/**",
    "lint:fix": "eslint src --ignore-pattern src/generated/** --fix"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.2"
  }
}
